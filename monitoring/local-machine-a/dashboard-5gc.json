{"__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "description": "Selectionner \"Prometheus (local, machine A)\" a l'import", "type": "datasource", "pluginId": "prometheus"}], "title": "NFV-5G - Dimensionnement (debit, sessions, CPU, RAM)", "uid": "nfv5g-dimensionnement", "schemaVersion": 39, "version": 1, "editable": true, "timezone": "browser", "time": {"from": "now-15m", "to": "now"}, "refresh": "10s", "panels": [{"id": 1, "title": "Debit reseau du conteneur UPF (cAdvisor, bits/s reels)", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []}, "targets": [{"expr": "rate(container_network_receive_bytes_total{name=\"upf\"}[1m]) * 8", "legendFormat": "Recu (upf)", "refId": "A"}, {"expr": "rate(container_network_transmit_bytes_total{name=\"upf\"}[1m]) * 8", "legendFormat": "Envoye (upf)", "refId": "B"}]}, {"id": 2, "title": "Sessions PDU actives (UPF)", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "fivegs_upffunction_upf_sessionnbr", "legendFormat": "Sessions UPF", "refId": "A"}]}, {"id": 3, "title": "CPU par NF (utilisation, rate)", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "targets": [{"expr": "rate(process_cpu_seconds_total{job=\"5gc-docker-local\"}[1m])", "legendFormat": "{{nf}}", "refId": "A"}]}, {"id": 4, "title": "RAM par NF (residente)", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "process_resident_memory_bytes{job=\"5gc-docker-local\"}", "legendFormat": "{{nf}}", "refId": "A"}]}]}
