# Modèle documentant les variables utilisées par le déploiement conteneurisé
# Open5GS (Borjis131/docker-open5gs). Le fichier .env réel est généré et
# rempli automatiquement par scripts/deploiement/01-deploy-open5gs.sh dans
# vendor/docker-open5gs/.env (non versionné, cf. .gitignore : *.env).
#
# Ce fichier sert uniquement de référence pour comprendre/reproduire la config.

# Version d'Open5GS utilisée pour builder les images (tag du projet open5gs/open5gs)
OPEN5GS_VERSION=v2.7.6

# Distribution Ubuntu de base pour les images
UBUNTU_VERSION=jammy

# Version de l'image MongoDB (base des abonnés)
# IMPORTANT : rester en 7.x, pas 8.x — MongoDB 8.0+ plante au démarrage sur les
# noyaux Linux >= 6.19 (bug connu TCMalloc, SERVER-121912). Voir
# docs/architecture/choix-deploiement-docker.md.
MONGODB_VERSION=7.0

# Version de Node.js pour builder la WebUI
NODE_VERSION=20

# IP de la machine hôte qui exécute Docker (auto-détectée par le script,
# utilisée dans upf.yaml pour l'adresse "advertise" du plan usager N3)
DOCKER_HOST_IP=<auto-détectée par le script de déploiement>
